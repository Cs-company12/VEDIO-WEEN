{
  "manifest_version": 3,
  "name": "Video Weyneeye",
  "version": "2.1",
  "description": "Button lagu weyneeyo video kasta, bog kasta (zoom, buuxi, dhaqaaji).",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    }
  ]
}
