{
  "manifest_version": 3,
  "name": "Video Weyneeye",
  "version": "1.0",
  "description": "Button lagu weyneeyo video kasta (zoom).",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
